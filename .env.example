# Noctivault NestJS 제작 워커 — 실제 키를 이 파일에 저장하지 마세요.
# 로컬: 이 파일을 .env로 복사한 뒤 입력합니다. 실제 .env는 Git에 올리지 않습니다.
# GitHub Actions: 필수 키와 버킷은 Repository Settings > Secrets and variables > Actions > Secrets에 등록합니다.
# 코드만 업로드해도 키가 전달되지는 않습니다. GitHub Secrets와 로컬 .env는 별도입니다.

# ── AI: 원고 생성·의미 중복·사실 검증 ──
# 필수. Anthropic API 키. 현재 모델은 코드에 고정: claude-haiku-4-5-20251001.
ANTHROPIC_API_KEY=

# ── AI: 음성·자막 ──
# 필수. OpenAI API 키. TTS: tts-1 / onyx / speed 0.92, 자막: whisper-1.
OPENAI_API_KEY=

# ── AI: 선택적 영상 재현 장면 ──
# Kling 사용 시 필수. fal API 키이며 Kling 자체 로그인 비밀번호가 아닙니다.
# fal-ai/kling-video/v3/standard/image-to-video / 무음 5초.
# 장면을 요청할 때만 사용하며 입력 이미지 권리 확인과 비용 예약을 거칩니다.
FAL_KEY=

# ── 영구 상태·중복·예산 ──
# 필수. Supabase 프로젝트 URL과 service_role 키. anon 키를 사용하지 않습니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── YouTube: 비공개 업로드·이력 조회·Studio 공개 상태 조회 ──
# 필수. 검수·공개 전환·성과 확인은 YouTube Studio에서 직접 합니다.
# node scripts/getRefreshToken.js --channel=mystery 로 refresh token을 발급할 수 있습니다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN_MYSTERY=
# 선택/로컬 OAuth 발급 도구 전용. 기본 8765. Cloud Console의 redirect URI와 맞춥니다.
YOUTUBE_OAUTH_REDIRECT_PORT=8765

# ── GCS: 원고·음성·자막·영상·Kling 결과 보존 ──
# 제작 시 필수. gs:// 접두어 없이 버킷 이름만 입력합니다.
GCS_BUCKET=
# 로컬 인증: 아래 표준 ADC 경로 또는 기존 호환 경로 중 하나만 입력합니다.
# 둘 다 비어 있으면 SDK의 Application Default Credentials를 사용합니다.
# JSON 원문을 이 경로 변수에 넣지 않습니다. 서비스 계정 파일은 Git에 올리지 않습니다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_SA_JSON_PATH=
# GitHub Actions 전용 Secret: GCP 서비스 계정 JSON 전체.
# google-github-actions/auth가 인증 파일과 ADC 환경을 구성하므로 로컬에는 입력하지 않아도 됩니다.
GCP_SA_KEY=

# ── 실행 설정 ──
# 선택. --count를 생략한 --run-daily의 기본 편수. --run-once는 항상 1편입니다.
DAILY_UPLOAD_COUNT=1
# 선택. 테스트 전용 값 test는 .env 로딩을 생략합니다. 일반 운영에서는 production 또는 미설정.
NODE_ENV=production

# ── 영상 자막 스타일 (모두 선택) ──
# Actions에서는 아래 항목을 Secrets가 아닌 Repository Variables에 같은 이름으로 등록할 수 있습니다.
# 폰트: 미설정 시 assets/fonts/fonts.json의 subtitle.family 사용.
SUBTITLE_FONT_NAME=
SUBTITLE_FONT_SIZE=78
# ASS 색상은 AABBGGRR 순서의 8자리 hex. AA=00 불투명, FF 투명.
SUBTITLE_PRIMARY_ABGR=00FFFFFF
SUBTITLE_SECONDARY_ABGR=000000FF
SUBTITLE_OUTLINE_ABGR=00000000
# 배경색 미설정 시 일반 80000000, 배경 박스 사용 시 AA000000.
SUBTITLE_BACK_ABGR=
SUBTITLE_BACK_BOX=false
SUBTITLE_BOLD=1
SUBTITLE_SPACING=1
SUBTITLE_OUTLINE=6
SUBTITLE_SHADOW=4
# top 또는 bottom. 기본 top. 여백은 세로 1080x1920 기준이며 롱폼은 렌더 단계에서 조정합니다.
SUBTITLE_PLACEMENT=top
SUBTITLE_MARGIN_LR=48
# 비어 있으면 top=150, bottom=135.
SUBTITLE_MARGIN_V=

# 사용하지 않는 예전 변수는 제거했습니다: GEMINI_API_KEY, PEXELS_API_KEY, FREESOUND_API_KEY,
# CLAUDE_MODEL, CLAUDE_SCRIPT_MODEL, GOOGLE_CLOUD_SA_JSON, CONTENT_HOOK_LEVEL,
# VIDEO_KEN_*, AUDIO_LOUDNORM, YOUTUBE_ATTRIBUTION_FOOTER, PORT, VITE_*.
# Qwen은 아직 연결하지 않으므로 Qwen 전용 설정은 없습니다. BGM은 현재 자동 혼합하지 않습니다.
