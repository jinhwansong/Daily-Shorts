# =============================================================================
# 복사: cp .env.example .env  (Windows: copy .env.example .env) 후 실제 값으로 교체
# dry-run 은 API 없이 FFmpeg 만 — npm run dry-run
# =============================================================================

# --- 필수 (실제 파이프라인) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PEXELS_API_KEY=

# --- 롱폼 Batch API (Nano Banana 2, 이미지 50% 할인) ---
# GCS 접근: 서비스 계정 키(JSON 파일)가 필요함. 아래 셋 중 하나만 쓰면 됨.
# (1) 로컬 추천: 키 파일 경로만 — GCP에서 받은 xxx.json 의 절대 경로 (내용 통째로 .env에 넣지 않음)
# GOOGLE_CLOUD_SA_JSON_PATH=E:\secrets\gcp-service-account.json
# (2) 로컬 대안: Google 표준 — (1)과 동일 파일을 가리키면 됨 (둘 중 하나만 있어도 됨)
# GOOGLE_APPLICATION_CREDENTIALS=E:\secrets\gcp-service-account.json
# (3) CI/GitHub Actions: Secret에 JSON 전체 문자열
# GOOGLE_CLOUD_SA_JSON={"type":"service_account",...}
GOOGLE_CLOUD_SA_JSON=
GOOGLE_CLOUD_SA_JSON_PATH=
# GCS 버킷 이름 (배치 결과 + state 저장용)
GCS_BUCKET=short-mystery-ai

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# getRefreshToken: Cloud Console "승인된 리디렉션 URI" = http://127.0.0.1:8765/ (기본, 끝 / 포함; 바꾸면 포트·Console 둘 다 맞출 것)
# YOUTUBE_OAUTH_REDIRECT_PORT=8765
YOUTUBE_REFRESH_TOKEN_MYSTERY=
# 업로드 시 공개 범위 (미설정 시 private). 비공개로 올린 뒤 스튜디오 업로드 화면의 자동 안내(저작권·제한 등) 확인·설명란(스크립트) 번역 검수 후 직접 공개하면 됨.
# YOUTUBE_PRIVACY_STATUS=private
# YOUTUBE_PRIVACY_STATUS=unlisted
# YOUTUBE_PRIVACY_STATUS=public

# --- 선택: Shorts 스크립트에 en.wikipedia 본문 일부(무료) 를 붙여 팩트 근거 (기본 1=씀) ---
# SHORTS_WIKI_CONTEXT=0
# WIKI_MAX_CHARS=5000
# WIKIPEDIA_USER_AGENT=MyBot/1.0 (https://yoursite.example/; you@email)

# --- 선택: Shorts 팩트 불릿 1회(하이쿠) → 스크립트는 위키+불릿 밖의 구체 주장 최소화 (기본 1=씀) ---
# SHORTS_FACTS_STEP=0

# --- 선택: 스크립트·토픽·메타 LLM (기본 anthropic) ---
# anthropic | openai | google
# SCRIPT_LLM_PROVIDER=google
# 공통으로 모델 덮어쓰기 (선택)
# SCRIPT_LLM_MODEL=gemini-2.0-flash
# 롱폼(사실 추출+스크립트+메타)만 다른 모델 (선택, 미설정 시 PROVIDER 기본/롱폼 규칙)
# SCRIPT_LLM_LONGFORM_MODEL=
# openai: OPENAI_API_KEY, (선택) OPENAI_TEXT_MODEL=gpt-4o-mini
# google: GEMINI_API_KEY, (선택) GEMINI_TEXT_MODEL=gemini-2.0-flash

# --- 선택: Claude 모델 (SCRIPT_LLM_PROVIDER=anthropic 이거나 기본일 때) ---
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- 선택: Freesound BGM (https://freesound.org/apiv2/apply) ---
FREESOUND_API_KEY=
# 크레딧·CC BY 검색 여부·영상 EQ/CRF/BGM 볼륨 기본값은 src/utils/pipelineDefaults.js (여기서 env 로만 덮어쓸 때)
# FREESOUND_APPEND_CREDIT=0
# FREESOUND_ALLOW_ATTRIBUTION=1

# --- 선택: 훅 강도 — normal(기본) | strong
# strong = 주제·스크립트·제목/썸네일 문구에 더 세게 (실제 사건·사실 범위, 유튜브 안전 가이드 준수 전제)
CONTENT_HOOK_LEVEL=normal

# --- 선택: 하루 배치 기본 개수 (CLI --count 가 우선) ---
DAILY_UPLOAD_COUNT=5

# --- 선택: FFmpeg 영상 보정·압축 기본값은 pipelineDefaults.js (덮어쓸 때만)
# VIDEO_EQ_BRIGHTNESS=-0.06
# VIDEO_EQ_SATURATION=0.88
# VIDEO_CRF=21
# VIDEO_PRESET=medium
# VIDEO_SHARPEN=1

# --- 선택: 영상·오디오 자동 후처리 (기본 켬 / 0 으로 끔)
# Pexels 세로 클립 여러 개 이어 붙임(듀얼): 기본 켬 — 단일 클립은 VIDEO_DUAL_BACKGROUND=0
# 이어 붙일 클립 수(2~8, 기본 4). 오디오 길이에 맞춰 각 구간 길이가 균등히 잘림
# VIDEO_BACKGROUND_SEGMENTS=4
# VIDEO_DUAL_BACKGROUND=0
# 첫 번째 배경 클립을 타임라인 끝에서 한 번 더 씀(비주얼 북엔드). 끄려면 0
# VIDEO_BOOKEND_REPEAT_FIRST=0
# 정적 배경에 아주 약한 줌 (zoompan, FFmpeg 버전에 따라 실패 시 0)
VIDEO_KEN_BURNS=1
# zoompan 프레임당 증가·상한 (너무 크면 화면이 튐)
VIDEO_KEN_ZOOM_INC=0.00007
VIDEO_KEN_MAX_ZOOM=1.08
# 최종 믹스 라우드니즈 (YouTube 쪽 청감에 가깝게)
AUDIO_LOUDNORM=1
# AUDIO_LOUDNORM_I=-16
# AUDIO_LOUDNORM_TP=-1.5
# AUDIO_LOUDNORM_LRA=11

# --- 선택: 자막 폰트 — 기본은 assets/fonts/fonts.json (subtitle.family)
# .env 에 SUBTITLE_FONT_NAME 을 쓰면 fonts.json 보다 우선합니다.
SUBTITLE_FONT_NAME=
SUBTITLE_FONT_SIZE=78
# ARGB 16진 8자리 또는 RGB 6자리 (앞에 &H 생략 가능). 기본은 순흰(00FFFFFF)로 대비 유지
SUBTITLE_PRIMARY_ABGR=00FFFFFF
SUBTITLE_OUTLINE_ABGR=00000000
SUBTITLE_OUTLINE=6
SUBTITLE_SHADOW=4
# 밝은 배경·상단 자막 가독성: 1 이면 글 뒤 반투명 박스(ASS BorderStyle 3). 박스 색은 SUBTITLE_BACK_ABGR
# SUBTITLE_BACK_BOX=1
# SUBTITLE_BACK_ABGR=AA000000
# top = 상단 중앙(Shorts 모바일 하단 UI와 분리) | bottom = 하단 중앙
SUBTITLE_PLACEMENT=top
# 상단일 때는 화면 위에서 아래로 여백(px), 하단일 때는 아래에서 위로 여백
SUBTITLE_MARGIN_V=150
SUBTITLE_MARGIN_LR=48
SUBTITLE_SPACING=1
# 0 이면 볼드 해제
SUBTITLE_BOLD=1
# 다른 폴더에 폰트만 모아 둔 경우
# SUBTITLE_FONTS_DIR=E:/fonts/shorts

# --- 선택: TTS 대비 배경음 볼륨 (기본 pipelineDefaults.js) ---
# BGM_VOLUME=0.14

# --- 토픽 시드 (mystery) — Wikipedia category members ---
# TOPIC_SEED_LIMIT=15
# WIKIPEDIA_SEED_CATEGORIES=Category:Unsolved_deaths,Category:Missing_person_cases
# WIKIPEDIA_USER_AGENT=ShortsPipeline/1.0 (contact: you@email)

# --- Claim gate: script/title strict claims vs Wikipedia/fact bullets ---
# CLAIM_GATE=1              # 0=비활성
# CLAIM_GATE_MODE=block     # block=실패 시 skip | warn=로그만

# --- 선택: YouTube 설명란 하단 고정 문구 (여러 줄은 \n 사용 가능) ---
YOUTUBE_ATTRIBUTION_FOOTER=Stock footage from Pexels. Voice and subtitles via AI.
