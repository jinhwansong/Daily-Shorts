{
  "name": "shorts-automation",
  "version": "1.0.0",
  "description": "Noctivault documentary production worker for GitHub Actions and YouTube Studio",
  "main": "dist/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dry-run": "node dist/main.js --dry-run --genre=mystery",
    "mystery": "node dist/main.js --run-daily --genre=mystery --count=1",
    "mystery-long": "node dist/main.js --run-once --genre=mystery-long",
    "mystery-long-daily": "node dist/main.js --run-daily --genre=mystery-long --count=1",
    "longform-phase1": "node dist/main.js --longform-phase1 --genre=mystery-long",
    "longform-phase2": "node dist/main.js --longform-phase2",
    "run-once": "node dist/main.js --run-once",
    "fill-review-topics": "node scripts/fillReviewTopics.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js --help",
    "sync:youtube": "node dist/main.js --sync-youtube",
    "presync:youtube": "npm run build",
    "pretest": "npm run build",
    "test:media": "npm run build && node --test tests/renderSmoke.test.js",
    "predry-run": "npm run build",
    "premystery": "npm run build",
    "premystery-long": "npm run build",
    "premystery-long-daily": "npm run build",
    "prelongform-phase1": "npm run build",
    "prelongform-phase2": "npm run build",
    "prerun-once": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/storage": "^8.4.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^16.4.0",
    "googleapis": "^186.0.0",
    "openai": "^4.77.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
